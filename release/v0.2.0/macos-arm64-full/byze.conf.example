# Byze v0.2.0 mainnet — example config for macOS
# Copy to: ~/Library/Application Support/Byze/byze.conf

server=1
listen=1
daemon=1

# Byze mainnet ports (NOT Bitcoin's 8333/8332)
port=8888
rpcport=8882
rpcbind=127.0.0.1
rpcallowip=127.0.0.1

# Set your own credentials before enabling RPC from other apps
# rpcuser=youruser
# rpcpassword=your_long_random_password

txindex=1
dbcache=512
maxconnections=64

# Quantum-capable address types
addresstype=bech32m
changetype=bech32m
fallbackfee=0.001

# First wallet creation can take several minutes (liboqs key derivation)
# keypool=10

# Built-in fixed seeds connect automatically on first launch.
# To add a peer manually:
# addnode=45.76.136.147:8888
